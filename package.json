{
  "name": "ssd-api-gateway",
  "version": "1.0.0",
  "description": "Dynamic Layer 7 API Gateway and Reverse Proxy with JWT authentication and hot-reloadable routing",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "auth": "node mock-services/authService.js",
    "users": "node mock-services/userService.js",
    "orders": "node mock-services/orderService.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "http-proxy-middleware": "^3.0.5",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}