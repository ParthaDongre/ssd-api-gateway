# Gateway and Microservices Ports
PORT=8000
AUTH_SERVICE_PORT=5001
USER_SERVICE_PORT=5002
ORDER_SERVICE_PORT=5003

# JWT Configuration
JWT_SECRET=supersecretkey123
JWT_EXPIRES_IN=1h

# AWS Cloud DynamoDB Configuration (AWS Student / Academy / Learner Lab)
# If left blank, the gateway runs in resilient local fallback mode.
# When provided, it connects directly to Amazon DynamoDB in the AWS Cloud.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
# AWS Academy / Learner Lab sessions require AWS_SESSION_TOKEN:
AWS_SESSION_TOKEN=

# DynamoDB Table Names (Automatically created in AWS with PAY_PER_REQUEST free tier billing)
DYNAMODB_USERS_TABLE=ssd_users
DYNAMODB_ORDERS_TABLE=ssd_orders
